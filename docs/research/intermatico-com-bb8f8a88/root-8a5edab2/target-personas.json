e\" style=\"display: none;\">\n\t\t\t\t\t\t\t\t\t\t\tAcceso por Reconocimiento Facial bloqueado.\n\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t<span id=\"errorAutenticacionCtaBloquedada\" class=\"value\" style=\"display: none;\">\n\t\t\t\t\t\t\t\t\t\t\t<!---->\n\t\t\t\t\t\t\t\t\t\t\tSu usuario se encuentra bloqueado, para habilitarlo ingrese a Desbloquear usuario u ¿Olvidó su contraseña?\n\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\n\n\n\t\t\t\t\t\t\t<div class=\"ld-flex ld-justify-center ld-w-full ld-mt-4\">\n\t\t\t\t\t\t\t\t<button id=\"continuar\" type=\"button\" onclick=\"assistBlock();bloquearUi();\" class=\"ld-btn-secondary ld-w-full redBtnContinuar\">\n\t\t\t\t\t\t\t\tDesbloquear usuario</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"ld-flex ld-justify-center ld-w-full ld-my-2\">\n\t\t\t\t\t\t\t\t<button id=\"btnHelp\" type=\"button\" onclick=\"assistHelp();bloquearUi();\" "
